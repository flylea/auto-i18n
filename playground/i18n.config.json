{
  "entryDirs": ["src/views", "src/components", "src/pages"],
  "extensions": ["vue", "jsx", "tsx"],
  "output": "ts",
  "outputDir": "src/i18n/locale",
  "withFileComment": false,
  "withKeyFileComment": false,
  "i18nFns": ["t", "$t"],
  "supportChineseKey": true,
  "languages": ["zh-CN", "en-US"],
  "batchSize": 0
}
